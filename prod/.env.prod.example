# Lumiris — production env template (self-hosted, single server).
#
# Copy to `.env.prod`, fill every REPLACE_ME, then keep the real file OUT of git
# by committing only the SOPS-encrypted copy (dotenv type must be explicit — the
# `.sops` extension isn't auto-detected):
#     sops -e --input-type dotenv --output-type dotenv .env.prod > secrets/prod.env.sops   # commit this
#     sops -d --input-type dotenv --output-type dotenv secrets/prod.env.sops > .env.prod   # to inspect locally
# The Ansible deploy decrypts it for you (community.sops lookup) → no manual step on the server.
#
# Generate strong secrets with:  openssl rand -base64 48

# ── Domain / TLS ─────────────────────────────────────────────────────────────
DOMAIN=lumiris.eu
# Let's Encrypt contact — ALSO set literally in traefik-prod/traefik.yml (static
# config is not env-interpolated).
ACME_EMAIL=ops@lumiris.eu

# ── Pinned image versions ────────────────────────────────────────────────────
TRAEFIK_VERSION=v3.5
POSTGRES_VERSION=17-alpine
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z

# ── PostgreSQL (on-box) ──────────────────────────────────────────────────────
POSTGRES_DB=lumiris
POSTGRES_USER=lumiris
POSTGRES_PASSWORD=REPLACE_ME_pg

# ── Redis (on-box) ───────────────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_ME_redis

# ── MinIO (on-box S3) ────────────────────────────────────────────────────────
# Single-box: the backend uses the root credentials and creates the bucket on
# startup (MinioConfig). MinIO is not exposed outside the internal network.
MINIO_ROOT_USER=lumiris-root
MINIO_ROOT_PASSWORD=REPLACE_ME_minio_root
MINIO_BUCKET=lumiris-uploads

# ── Backend: auth + CORS ─────────────────────────────────────────────────────
# 256-bit minimum; the app fails to start if unset.
JWT_SECRET=REPLACE_ME_jwt_min_32_chars
# Exact scheme+host list (wildcards not allowed with credentials).
CORS_ALLOWED_ORIGINS=https://lumiris.eu,https://www.lumiris.eu,https://app.lumiris.eu,https://admin.lumiris.eu,https://mobile.lumiris.eu
FLYWAY_LOCATIONS=classpath:db/migration

# ── Stripe (use LIVE keys in prod; do NOT reuse the test keys from the repo) ──
STRIPE_SECRET_KEY=REPLACE_ME_sk_live
STRIPE_PUBLISHABLE_KEY=REPLACE_ME_pk_live
STRIPE_WEBHOOK_SECRET=REPLACE_ME_whsec
STRIPE_BOOTSTRAP_CATALOG=true
# Return URL for Stripe Connect onboarding + Customer Portal → prod front.
STRIPE_PORTAL_RETURN_URL=https://app.lumiris.eu/subscription
STRIPE_PRODUCT_SOLO=REPLACE_ME_prod_id
STRIPE_PRODUCT_STUDIO=REPLACE_ME_prod_id
STRIPE_PRODUCT_MAISON=REPLACE_ME_prod_id
STRIPE_PRODUCT_ATELIER_PLUS=REPLACE_ME_prod_id
STRIPE_PRODUCT_LOCAL=REPLACE_ME_prod_id

# ── Mail (Resend) ────────────────────────────────────────────────────────────
# Blank key = MailService logs and drops instead of sending (never blocking).
# MAIL_FROM must sit on a domain verified in the Resend dashboard; the shared
# sandbox sender onboarding@resend.dev only ever delivers to the Resend account
# owner's own address.
RESEND_API_KEY=REPLACE_ME_re_key
MAIL_FROM=no-reply@lumiris.eu
# Origin of the consumer app (serves /p and the other public routes). Emails have
# no origin of their own to prefix, so absolute links are built from this.
FRONTEND_URL=https://mobile.lumiris.eu

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a pair with `npx web-push generate-vapid-keys`. Blank = push disabled
# (PushNotificationService erases itself, same contract as Resend above). The
# public key is served to browsers by GET /api/push/vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@lumiris.eu

# ── Blockchain anchoring ─────────────────────────────────────────────────────
# NOT optional at startup: BlockchainConfig eagerly builds Web3j + Credentials,
# so the private key MUST be a valid hex secp256k1 key (empty/unset → the app
# crashes on boot). Use a throwaway UNFUNDED key to effectively disable anchoring
# (it then fails silently at anchor time). Generate: 0x$(openssl rand -hex 32).
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_WALLET_PRIVATE_KEY=REPLACE_ME_0x_hex64
GEOCODING_USER_AGENT=lumiris-prod

# ── Sentry error monitoring (optional) ───────────────────────────────────────
SENTRY_DSN_API=
SENTRY_DSN_SITE=
SENTRY_DSN_CLIENT=
SENTRY_DSN_ADMIN=

# ── Monitoring: Grafana Cloud (via docker-compose.monitoring.yml overlay) ────
# From your free Grafana Cloud account → "Prometheus" data source details:
#   URL  = https://prometheus-prod-XX-YYY.grafana.net/api/prom/push
#   user = your numeric instance/stack ID
#   key  = a Cloud Access Policy token with metrics:write
ALLOY_VERSION=v1.5.1
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_KEY=
# Optional (only if you enable the Loki logs block in config.alloy):
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=

# ── WAF: CrowdSec (via docker-compose.crowdsec.yml overlay) ──────────────────
CROWDSEC_VERSION=v1.6.4
# Shared secret between CrowdSec LAPI and the Traefik bouncer plugin.
# Generate: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=REPLACE_ME_crowdsec_key
